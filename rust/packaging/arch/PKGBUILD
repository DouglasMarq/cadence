pkgname=cadence-git
pkgver=0.1.0.r0.g0000000
pkgrel=1
pkgdesc="Cadence, a fast native music player for Navidrome, OpenSubsonic and Jellyfin"
arch=('x86_64' 'aarch64')
url="https://github.com/DouglasMarq/cadence"
license=('MIT')
depends=('mpv' 'fontconfig' 'ttf-font' 'libgcc' 'glibc' 'hicolor-icon-theme' 'libglvnd'
         'libxkbcommon' 'libxkbcommon-x11' 'wayland' 'libx11' 'libxcursor' 'libxi' 'libxrandr')
makedepends=('cargo' 'git' 'pkgconf')
provides=('cadence')
conflicts=('cadence')
options=('!lto' '!debug')
source=("cadence::${CADENCE_SOURCE:-git+https://github.com/DouglasMarq/cadence.git#branch=main}")
sha256sums=('SKIP')

pkgver() {
    cd cadence/rust
    local workspace_version
    workspace_version="$(sed -n 's/^version = "\(.*\)"$/\1/p' Cargo.toml | head -n1)"
    printf "%s.r%s.g%s" "$workspace_version" "$(git rev-list --count HEAD)" "$(git rev-parse --short=7 HEAD)"
}

prepare() {
    cd cadence/rust
    export RUSTUP_TOOLCHAIN=stable
    cargo fetch --locked --target "$(rustc --print host-tuple)"
}

build() {
    cd cadence/rust
    export RUSTUP_TOOLCHAIN=stable
    export CARGO_TARGET_DIR=target
    export RUSTFLAGS="${RUSTFLAGS:-} --remap-path-prefix=$srcdir=/usr/src/debug/$pkgname"
    cargo build --frozen --release -p cadence
}

package() {
    cd cadence/rust
    install -Dm755 target/release/cadence "$pkgdir/usr/bin/cadence"
    bash packaging/install-desktop-integration.sh "$pkgdir/usr"
    install -Dm644 ../LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
