import { ListView } from "std-widgets.slint";
import { Motion, Theme, Icons } from "theme.slint";
import { AppState, Route } from "globals.slint";
import { Icon, IconButton, SearchField, TooltipComboBox } from "widgets.slint";
import { CoverArt, PlayButton } from "cover_art.slint";
import { Cell, Skeleton } from "tracks.slint";

export struct ArtistCard {
    id: string,
    name: string,
    albums: string,
    songs: string,
    is-favorite: bool,
    image: image,
    has-image: bool,
}

export struct ArtistGridRow {
    cards: [ArtistCard],
}

export global ArtistIcons {
    out property <string> grid: "M4 11h5V5H4v6zm0 7h5v-6H4v6zm6 0h5v-6h-5v6zm6 0h5v-6h-5v6zm-6-7h5V5h-5v6zm6-6v6h5V5h-5z";
    out property <string> list: "M3 14h4v-4H3v4zm0 5h4v-4H3v4zM3 9h4V5H3v4zm5 5h13v-4H8v4zm0 5h13v-4H8v4zM8 5v4h13V5H8z";
}

export global ArtistsState {
    in property <[ArtistCard]> items;
    in property <[ArtistGridRow]> grid-rows;
    in property <[string]> sort-options;
    in property <bool> is-loading;
    in property <bool> is-complete;
    in-out property <int> sort-index;
    in-out property <bool> is-descending;
    in-out property <bool> is-favorites-only;
    in-out property <bool> is-grid: true;
    callback load(string);
    callback query-changed();
    callback search-edited(string);
    callback set-columns(int);
    callback play(string);
}

export component ArtistImage inherits CoverArt {
    is-round: true;
    background: Theme.surface-raised;
    icon: Icons.artist;
    icon-color: Theme.muted;
    icon-size: self.width * 0.4;
}

component ArtistCardView inherits Rectangle {
    in property <ArtistCard> card;
    border-radius: Theme.radius-card;
    background: touch.has-hover ? Theme.hover : transparent;
    accessible-role: button;
    accessible-label: root.card.name;
    accessible-action-default => {
        AppState.navigate(Route.artist-detail, root.card.id);
    }

    animate background {
        duration: Motion.quick;
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            AppState.navigate(Route.artist-detail, root.card.id);
        }
    }

    image := CoverArt {
        x: 12px;
        y: 12px;
        width: parent.width - 24px;
        height: self.width;
        source: root.card.image;
        has-source: root.card.has-image;
        icon: Icons.artist;
        is-round: true;
        is-hovered: touch.has-hover || play-badge.is-hovered;
    }

    play-badge := PlayButton {
        x: image.x + image.width - self.width - 4px;
        y: image.y + image.height - self.height - 4px;
        size: 40px;
        is-shown: touch.has-hover || self.is-hovered;
        tooltip: @tr("Play");
        clicked => {
            ArtistsState.play(root.card.id);
        }
    }

    Text {
        x: 12px;
        y: image.y + image.height + 10px;
        width: parent.width - 24px;
        text: root.card.name;
        color: Theme.foreground;
        font-weight: 600;
        horizontal-alignment: center;
        overflow: elide;
    }

    Text {
        x: 12px;
        y: image.y + image.height + 30px;
        width: parent.width - 24px;
        text: root.card.albums;
        color: Theme.muted;
        font-size: 12px;
        horizontal-alignment: center;
        overflow: elide;
    }
}

component ArtistRowView inherits Rectangle {
    in property <ArtistCard> card;
    in property <int> index;
    height: 48px;
    background: touch.has-hover ? Theme.hover : transparent;

    animate background {
        duration: Motion.quick;
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            AppState.navigate(Route.artist-detail, root.card.id);
        }

        HorizontalLayout {
            padding-left: 20px;
            padding-right: 20px;
            spacing: 12px;

            Rectangle {
                width: 32px;

                if !touch.has-hover: Text {
                    width: parent.width;
                    text: root.index + 1;
                    color: Theme.muted;
                    horizontal-alignment: right;
                    vertical-alignment: center;
                }

                if touch.has-hover: IconButton {
                    x: parent.width - self.width;
                    icon: Icons.play;
                    icon-color: Theme.foreground;
                    tooltip: @tr("Play");
                    clicked => {
                        ArtistsState.play(root.card.id);
                    }
                }
            }

            ArtistImage {
                y: (parent.height - self.height) / 2;
                width: 36px;
                height: 36px;
                source: root.card.image;
                has-source: root.card.has-image;
            }

            Cell {
                horizontal-stretch: 1;
                text: root.card.name;
                text-color: Theme.foreground;
            }

            Cell {
                width: 120px;
                text: root.card.albums;
            }

            Cell {
                width: 120px;
                text: root.card.songs;
            }

            Rectangle {
                width: 32px;

                if root.card.is-favorite: Icon {
                    path: Icons.heart;
                    color: Theme.danger;
                    width: 18px;
                    height: 18px;
                }
            }
        }
    }
}

component ArtistsControls inherits HorizontalLayout {
    in property <bool> is-compact;
    property <length> search-max-width: root.is-compact ? 4000px : 240px;
    spacing: 8px;

    TooltipComboBox {
        tooltip: @tr("Sort by {}", self.current-value);
        min-width: 90px;
        preferred-width: 150px;
        max-width: 150px;
        horizontal-stretch: 1;
        model: ArtistsState.sort-options;
        current-index <=> ArtistsState.sort-index;
        selected => {
            ArtistsState.query-changed();
        }
    }

    IconButton {
        y: (parent.height - self.height) / 2;
        icon: ArtistsState.is-descending ? Icons.arrow-down : Icons.arrow-up;
        tooltip: ArtistsState.is-descending ? @tr("Sort: descending") : @tr("Sort: ascending");
        clicked => {
            ArtistsState.is-descending = !ArtistsState.is-descending;
            ArtistsState.query-changed();
        }
    }

    IconButton {
        y: (parent.height - self.height) / 2;
        icon: ArtistsState.is-favorites-only ? Icons.heart : Icons.heart-outline;
        is-active: ArtistsState.is-favorites-only;
        tooltip: ArtistsState.is-favorites-only ? @tr("Favorites only: on") : @tr("Favorites only: off");
        clicked => {
            ArtistsState.is-favorites-only = !ArtistsState.is-favorites-only;
            ArtistsState.query-changed();
        }
    }

    IconButton {
        y: (parent.height - self.height) / 2;
        icon: ArtistsState.is-grid ? ArtistIcons.list : ArtistIcons.grid;
        tooltip: ArtistsState.is-grid ? @tr("Switch to list view") : @tr("Switch to grid view");
        clicked => {
            ArtistsState.is-grid = !ArtistsState.is-grid;
        }
    }

    SearchField {
        min-width: 80px;
        preferred-width: 240px;
        max-width: root.search-max-width;
        horizontal-stretch: 1;
        placeholder-text: @tr("Search");
        edited(text) => {
            ArtistsState.search-edited(text);
        }
    }
}

export component ArtistsView inherits Rectangle {
    property <bool> has-compact-header: root.width < 600px;
    property <length> gap: 8px;
    property <length> min-card: 170px;
    property <length> grid-width: body.width - 44px;
    property <int> columns: max(1, floor((root.grid-width + root.gap) / (root.min-card + root.gap)));
    property <length> card-width: (root.grid-width - root.gap * (root.columns - 1)) / root.columns;
    background: Theme.panel;
    min-width: 320px;

    init => {
        ArtistsState.set-columns(root.columns);
        ArtistsState.load(AppState.detail-id);
    }

    changed columns => {
        ArtistsState.set-columns(root.columns);
    }

    VerticalLayout {
        VerticalLayout {
            padding: 20px;
            padding-bottom: 12px;
            spacing: 8px;

            HorizontalLayout {
                spacing: 8px;

                Text {
                    text: @tr("Artists");
                    font-size: 24px;
                    font-weight: 700;
                    color: Theme.foreground;
                    vertical-alignment: center;
                }

                Text {
                    text: ArtistsState.is-complete ? ArtistsState.items.length : "";
                    color: Theme.muted;
                    vertical-alignment: center;
                }

                Rectangle {
                    horizontal-stretch: 1;
                }

                if !root.has-compact-header: ArtistsControls { }
            }

            if root.has-compact-header: ArtistsControls {
                is-compact: true;
            }
        }

        body := Rectangle {
            vertical-stretch: 1;
            min-width: 0px;
            clip: true;

            if ArtistsState.is-grid: ListView {
                for row in ArtistsState.grid-rows: HorizontalLayout {
                    padding-left: 16px;
                    padding-right: 16px;
                    padding-bottom: root.gap;
                    spacing: root.gap;
                    alignment: start;

                    for card in row.cards: ArtistCardView {
                        width: root.card-width;
                        height: root.card-width + 40px;
                        card: card;
                    }
                }
            }

            if !ArtistsState.is-grid: VerticalLayout {
                Rectangle {
                    height: 33px;

                    HorizontalLayout {
                        padding-left: 20px;
                        padding-right: 20px;
                        spacing: 12px;

                        Cell {
                            width: 32px + 12px + 36px;
                            text: "#";
                        }

                        Cell {
                            horizontal-stretch: 1;
                            text: @tr("Name");
                        }

                        Cell {
                            width: 120px;
                            text: @tr("Albums");
                        }

                        Cell {
                            width: 120px;
                            text: @tr("Songs");
                        }

                        Rectangle {
                            width: 32px;
                        }
                    }

                    Rectangle {
                        y: parent.height - 1px;
                        height: 1px;
                        background: Theme.border;
                    }
                }

                ListView {
                    for card[card-index] in ArtistsState.items: ArtistRowView {
                        card: card;
                        index: card-index;
                    }
                }
            }

            if ArtistsState.is-loading && ArtistsState.items.length == 0: VerticalLayout {
                padding: 24px;
                spacing: 16px;
                alignment: start;

                for skeleton-index in 4: Skeleton {
                    width: 240px - skeleton-index * 30px;
                }
            }

            if !ArtistsState.is-loading && ArtistsState.is-complete && ArtistsState.items.length == 0: Text {
                text: @tr("No artists found");
                color: Theme.muted;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
    }
}
