export enum DiscoverSection { for-you, new-releases, charts, moods }

export enum DiscoverCardKind { song, album, playlist, mix }

export enum DiscoverNotice { none, info, warning }

export enum DiscoverPageKind { playlist, album, search-results, mix }

export struct DiscoverCard {
    kind: DiscoverCardKind,
    id: string,
    title: string,
    subtitle: string,
    cover: image,
    has-cover: bool,
    can-load-cover: bool,
}

export struct DiscoverShelf {
    title: string,
    cards: [DiscoverCard],
}

export struct DiscoverSong {
    id: string,
    index: int,
    title: string,
    artists: string,
    album: string,
    duration: string,
    cover: image,
    has-cover: bool,
    can-load-cover: bool,
}

export global DiscoverIcons {
    out property <string> explore: "M12 10.9c-.61 0-1.1.49-1.1 1.1s.49 1.1 1.1 1.1c.61 0 1.1-.49 1.1-1.1s-.49-1.1-1.1-1.1zM12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm2.19 12.19L6 18l3.81-8.19L18 6l-3.81 8.19z";
    out property <string> back: "M20 11H7.83l5.59-5.59L12 4l-8 8 8 8 1.41-1.41L7.83 13H20v-2z";
    out property <string> open-external: "M19 19H5V5h7V3H5c-1.11 0-2 .9-2 2v14c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2v-7h-2v7zM14 3v2h3.59l-9.83 9.83 1.41 1.41L19 6.41V10h2V3h-7z";
}

export global DiscoverState {
    in-out property <DiscoverSection> section: DiscoverSection.for-you;
    in property <[DiscoverShelf]> shelves;
    in property <bool> is-loading;
    in property <string> error;
    in property <string> notice;
    in property <DiscoverNotice> notice-kind;
    in property <[string]> countries;
    in-out property <int> country-index;
    in property <[string]> moods;
    in property <int> mood-index: -1;
    in-out property <string> search-text;
    in property <DiscoverPageKind> page-kind;
    in property <string> page-title;
    in property <string> page-subtitle;
    in property <image> page-cover;
    in property <bool> has-page-cover;
    in property <bool> is-page-loading;
    in property <string> page-error;
    in property <bool> has-page-link;
    in property <[DiscoverSong]> songs;
    callback open(detail-id: string);
    callback select-section(section: DiscoverSection);
    callback refresh();
    callback select-country(index: int);
    callback select-mood(index: int);
    callback search(query: string);
    callback cover-needed(shelf: int, card: int);
    callback song-cover-needed(index: int);
    callback card-visibility-changed(shelf: int, card: int, is-visible: bool);
    callback song-rows-shown(first-row: int, row-count: int);
    callback play-from-card(shelf: int, card: int);
    callback play-card(shelf: int, card: int);
    callback play-card-next(shelf: int, card: int);
    callback queue-card(shelf: int, card: int);
    callback open-card-in-browser(shelf: int, card: int);
    callback play-song(index: int);
    callback play-song-next(index: int);
    callback queue-song(index: int);
    callback open-song-in-browser(index: int);
    callback play-page();
    callback queue-page();
    callback open-page-in-browser();
}
